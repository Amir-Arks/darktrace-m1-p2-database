# =============================================================================
# DarkTrace M1 — Pod 2 | Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.
# =============================================================================

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Development (SQLite — default, no server needed):
DATABASE_URL=sqlite:///./darktrace.db

# Production (PostgreSQL — uncomment and fill in real credentials):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# ── FASTAPI ──────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true                   # set false in production

# ── SECURITY ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
