# =====================================================================
# DarkTrace M1 Pod 2 - Environment Configuration Template
# DO NOT commit real secrets or passwords to this file or to Git.
# Copy this file to '.env' locally and replace with your local values.
# =====================================================================

# PostgreSQL Database Connection URL (Recommended format using psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:your_local_password@localhost:5432/darktrace_pod2

# Optional fallback for lightweight offline local development / testing:
# DATABASE_URL=sqlite:///./darktrace_dev.db

# Environment mode: development, testing, production
ENVIRONMENT=development

# Application settings
APP_NAME=DarkTrace M1 Pod 2 Backend
DEBUG=True
API_V1_PREFIX=/api/v1
